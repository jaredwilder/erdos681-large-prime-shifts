def killTbl : List (Nat × Nat) := [(101, 3), (103, 5), (105, 23), (107, 3), (109, 7), (111, 37), (113, 3), (115, 587), (119, 3), (121, 29), (123, 5), (125, 3), (127, 31), (129, 131), (131, 3), (133, 5), (135, 11), (137, 3), (139, 83), (141, 19), (143, 3), (145, 13), (147, 47), (149, 3), (151, 7), (153, 5), (155, 3), (157, 11), (159, 17), (161, 3), (163, 5), (165, 7), (167, 3), (169, 59), (171, 13), (173, 3), (175, 311), (177, 619), (179, 3), (181, 173), (183, 5), (185, 3), (187, 239), (189, 31), (191, 3), (193, 5), (197, 3), (199, 347)]
def primeKs : List Nat := [9, 31, 45, 117, 195, 247, 271, 297, 337, 351, 357, 367, 385, 409, 435, 439, 441, 451, 477, 489, 507, 517, 541, 549, 595, 625, 645, 667, 675, 727, 765, 775, 811, 889, 919, 955, 957, 967, 987]
def covered (p k : Nat) : Bool := primeKs.contains k || killTbl.any (fun e => e.1 == k && 2 ≤ e.2 && e.2 ≤ k * k && (p - 1 + k) % e.2 == 0)

theorem msl_erdos681_bigbad_kills_100_200  : ((List.range 100).map (· + 100)).all (fun k => k % 2 == 0 || k < 3 || covered 999997304513 k) = true := by decide +kernel
