def covered (p k : Nat) : Bool := primeKs.contains k || killTbl.any (fun e => e.1 == k && 2 ≤ e.2 && e.2 ≤ k * k && (p - 1 + k) % e.2 == 0)

theorem msl_erdos681_bigbad_kills_0_100  : ((List.range 100).map (· + 0)).all (fun k => k % 2 == 0 || k < 3 || covered 999997304513 k) = true := by decide +kernel
