def killTbl : List (Nat × Nat) := [(401, 3), (403, 5), (405, 13), (407, 3), (411, 29), (413, 3), (415, 907), (417, 7), (419, 3), (421, 11), (423, 5), (425, 3), (427, 23), (429, 47), (431, 3), (433, 5), (437, 3), (443, 3), (445, 7), (447, 463), (449, 3), (453, 5), (455, 3), (457, 13), (459, 7), (461, 3), (463, 5), (465, 11), (467, 3), (469, 29), (471, 83), (473, 3), (475, 53), (479, 3), (481, 37), (483, 5), (485, 3), (487, 7), (491, 3), (493, 5), (495, 156119), (497, 3), (499, 17)]
def primeKs : List Nat := [9, 31, 45, 117, 195, 247, 271, 297, 337, 351, 357, 367, 385, 409, 435, 439, 441, 451, 477, 489, 507, 517, 541, 549, 595, 625, 645, 667, 675, 727, 765, 775, 811, 889, 919, 955, 957, 967, 987]
def covered (p k : Nat) : Bool := primeKs.contains k || killTbl.any (fun e => e.1 == k && 2 ≤ e.2 && e.2 ≤ k * k && (p - 1 + k) % e.2 == 0)

theorem msl_erdos681_bigbad_kills_400_500  : ((List.range 100).map (· + 400)).all (fun k => k % 2 == 0 || k < 3 || covered 999997304513 k) = true := by decide +kernel
